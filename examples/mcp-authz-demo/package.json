{
  "name": "mcp-authz-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Acme Docs MCP server showcasing the Authgear Authorization Decision API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "dev": "node --import tsx --watch src/server.ts",
    "setup": "node --import tsx scripts/setup-local.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "demo": "node --import tsx scripts/demo-client.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && cp -r src/console/public dist/console/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
