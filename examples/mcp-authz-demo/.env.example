# Copy to .env. Values below match a default local Authgear (see CONTRIBUTING.md).

# --- This MCP server ---
PORT=4100
# Bind address. Defaults to 127.0.0.1; set 0.0.0.0 to expose (not recommended, see README).
# HOST=127.0.0.1
# Where MCP clients reach this server (used in resource metadata and WWW-Authenticate).
PUBLIC_URL=http://localhost:4100
# The Authgear Resource URI of this server. It must appear in the access token `aud`.
RESOURCE_URI=https://docs.acme.localhost

# --- Authgear ---
# Issuer / project endpoint.
AUTHGEAR_ENDPOINT=http://localhost:3100
# Project ID. It is the `aud` of Admin API tokens.
APP_ID=accounts
# Portal base URL, for the "Why?" links in the Decision Console.
PORTAL_URL=http://localhost:8000

# --- PDP client (m2m client from authgear.yaml.snippet) ---
PDP_CLIENT_ID=acme-docs-pdp
# Generate with `openssl rand -base64 32`; must match the client secret in Authgear.
PDP_CLIENT_SECRET=CHANGE_ME
# Fail closed if the PDP does not answer within this many ms.
PDP_TIMEOUT_MS=2000

# --- npm run seed (Admin API) ---
# Admin API GraphQL URL and the Host header used to select the project.
ADMIN_API_ENDPOINT=http://localhost:3002/graphql
ADMIN_API_HOST=localhost:3100
# Admin API key from the portal (Advanced -> Admin API) or authgear.secrets.yaml.
ADMIN_API_KEY_ID=
# Paste the PEM with literal \n between lines, or use a multi-line quoted value.
ADMIN_API_PRIVATE_KEY_PEM=

# --- npm run demo ---
DEMO_CLIENT_ID=acme-docs-demo
# MCP_URL=http://localhost:4100/mcp
